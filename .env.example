# Server-only database connection for the isolated SaMi Errands database.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# One-time bootstrap secret for the first operations administrator (32+ random characters).
ADMIN_BOOTSTRAP_TOKEN=replace-with-a-long-random-secret

# Interactive maps use OpenStreetMap tiles and OSRM/Nominatim by default; no map key is required.
# NEXT_PUBLIC_ is used only for the public tile URL (not secret credentials).
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_ROUTING_BASE_URL=https://router.project-osrm.org
MAP_GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
MAP_CONTACT_EMAIL=

# Optional Google providers. Keep keys server-side; the code uses them only for the service selected.
# GOOGLE_ROUTES_API_KEY enables Google Routes road distance and route geometry.
# GOOGLE_GEOCODING_API_KEY enables Google address search.
# GOOGLE_MAPS_API_KEY can be used as a shared server-side key for both services.
GOOGLE_ROUTES_API_KEY=
GOOGLE_GEOCODING_API_KEY=
GOOGLE_MAPS_API_KEY=

# M-PESA Daraja STK Push. Keep these server-side; never prefix them with NEXT_PUBLIC_.
# The integration stays unavailable until the required values are configured in Vercel Preview.
MPESA_ENV=sandbox
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_SHORTCODE=
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_CALLBACK_TOKEN=replace-with-another-long-random-secret
# Optional. Defaults to this deployment's /api/payments/mpesa/callback endpoint.
# MPESA_CALLBACK_URL=https://your-preview-host/api/payments/mpesa/callback
