{
  "name": "sami-assist-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "npm run test:foundation",
    "test:foundation": "node --test tests/category-1-6-foundation.test.mjs tests/category-7-9-access-boundaries.test.mjs",
    "test:authorization": "tsx --test tests/category-8-authorization-security.test.ts",
    "test:all": "npm run test:foundation && npm run test:authorization && npm run test:category10 && npm run test:category11 && npm run test:category12 && npm run build",
    "check:backup": "node scripts/check-backup-readiness.mjs",
    "drill:backup": "node --conditions=react-server --import tsx scripts/tenant-recovery-drill.ts",
    "migrate:tenant-core": "node --conditions=react-server --import tsx scripts/migrate-tenant-core.ts",
    "test:category10": "node --test tests/category-10-organization-company-profile.test.mjs",
    "test:category11": "node --test tests/category-11-workspace-shell.test.mjs",
    "test:category12": "node --test tests/category-12-navigation-app-registry.test.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1133.0",
    "@stripe/react-stripe-js": "^6.8.2",
    "@stripe/stripe-js": "^9.14.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "groq-sdk": "^1.3.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.24.0",
    "next": "16.2.10",
    "node-sql-parser": "^5.4.0",
    "nodemailer": "^9.0.6",
    "openai": "^6.46.0",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "resend": "^6.24.0",
    "server-only": "0.0.1",
    "speakeasy": "^2.0.0",
    "stripe": "^22.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/speakeasy": "^2.0.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
