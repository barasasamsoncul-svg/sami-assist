# Only for the Runner API deployment.
# Use Neon project SaMi Runner / branch main / database sami_runner.
RUNNER_DATABASE_URL=postgresql://sami_runner_owner:REPLACE_ME@REPLACE_ME/sami_runner?sslmode=require

# Twilio Verify credentials for Runner phone OTP.
RUNNER_TWILIO_API_KEY=
RUNNER_TWILIO_API_SECRET=
RUNNER_TWILIO_VERIFY_SERVICE_SID=

# Optional session lifetime (default 30 days).
RUNNER_SESSION_DAYS=30

# Future Customer/Runner signed webhook secret. Leave empty until the
# integration contract and receiver are implemented.
CUSTOMER_RUNNER_WEBHOOK_SECRET=