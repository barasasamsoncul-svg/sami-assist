{
  "expo": {
    "name": "SaMi Runner",
    "slug": "sami-runner",
    "scheme": "samirunner",
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": ["android", "ios"],
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000535",
          "image": "./assets/icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#000535",
            "image": "./assets/icon.png"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SaMi Runner uses your location while you are working on an accepted errand so the customer can follow the progress."
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ]
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sami.runner",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "SaMi Runner shares your location with the customer during an active errand."
      },
      "backgroundColor": "#000535"
    },
    "android": {
      "package": "com.sami.runner",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "softwareKeyboardLayoutMode": "resize",
      "backgroundColor": "#000535",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000535"
      }
    },
    "experiments": {
      "typedRoutes": true
    },
    "backgroundColor": "#000535",
    "web": {
      "backgroundColor": "#000535"
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/8fcd647e-3514-4436-b1ce-c1b417f6c1d3",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8fcd647e-3514-4436-b1ce-c1b417f6c1d3"
      }
    },
    "owner": "sami-assist",
    "androidStatusBar": {
      "backgroundColor": "#000535",
      "barStyle": "light-content",
      "translucent": false
    }
  }
}