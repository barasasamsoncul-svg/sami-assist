# Public Mapbox token used by the native Mapbox map at runtime.
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.YOUR_PUBLIC_MAPBOX_TOKEN

# Secret token with Downloads:Read scope. Configure as an EAS environment secret.
# Do not commit a real value or expose this through EXPO_PUBLIC_*.
MAPBOX_DOWNLOADS_TOKEN=sk.YOUR_SECRET_DOWNLOADS_TOKEN

# Temporary legacy dashboard map key. Remove when the Mapbox dashboard cutover is complete.
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

# SaMi API
EXPO_PUBLIC_SAMI_API_URL=https://sami-assist.vercel.app
