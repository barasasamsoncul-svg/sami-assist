# Add these values to the existing root .env.local for local development
# and to the existing sami-assist Vercel project's encrypted variables.
# Do not change the existing DATABASE_URL; this is Runner's separate database.
RUNNER_DATABASE_URL=postgresql://sami_runner_owner:REPLACE_ME@REPLACE_ME/sami_runner?sslmode=require

RUNNER_TWILIO_API_KEY=
RUNNER_TWILIO_API_SECRET=
RUNNER_TWILIO_VERIFY_SERVICE_SID=
RUNNER_SESSION_DAYS=30

# Set only after implementing the authenticated Customer/Runner webhook contract.
CUSTOMER_RUNNER_WEBHOOK_SECRET=