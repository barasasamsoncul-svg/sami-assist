{
  "name": "sami-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "doctor": "expo-doctor",
    "build:android:apk": "npx eas-cli@latest build --platform android --profile production",
    "build:android:production": "npx eas-cli@latest build --platform android --profile production",
    "update:production": "npx eas-cli@latest update --channel production --platform android"
  },
  "dependencies": {
    "expo": "~57.0.31",
    "expo-location": "~57.0.22",
    "expo-router": "~57.0.27",
    "expo-secure-store": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-webview": "13.16.1",
    "expo-updates": "~57.0.12",
    "expo-constants": "~57.0.9",
    "expo-linking": "~57.0.5",
    "expo-font": "~57.0.4",
    "react-native-maps": "1.27.2",
    "expo-file-system": "~57.0.7",
    "expo-sharing": "~57.0.19"
  },
  "devDependencies": {
    "@types/react": "~19.2.3",
    "typescript": "~6.0.3"
  }
}
