{
  "name": "sami-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "doctor": "expo-doctor",
    "build:android:apk": "npx eas-cli@latest build --platform android --profile production",
    "build:android:production": "npx eas-cli@latest build --platform android --profile production",
    "update:production": "npx eas-cli@latest update --channel production --platform android"
  },
  "dependencies": {
    "@config-plugins/react-native-webrtc": "15.0.2",
    "@expo/vector-icons": "^15.0.2",
    "expo": "~57.0.31",
    "expo-constants": "~57.0.9",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image-picker": "~57.0.21",
    "expo-linking": "~57.0.5",
    "expo-location": "~57.0.22",
    "expo-router": "~57.0.27",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.24",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.12",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-maps": "1.27.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-webrtc": "124.0.8"
  },
  "devDependencies": {
    "@types/react": "~19.2.3",
    "typescript": "~6.0.3"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-webrtc"
        ]
      }
    }
  }
}
