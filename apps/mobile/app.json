
{
  "expo": {
    "name": "SaMi",
    "slug": "sami-mobile",
    "scheme": "sami",
    "version": "1.0.0",
    "icon": "./assets/sami-app-icon-1024.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#000535",
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000535",
          "image": "./assets/sami-welcome-wordmark-transparent.png",
          "imageWidth": 260,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#000535",
            "image": "./assets/sami-welcome-wordmark-transparent.png"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SaMi uses your location to set errand pickup points and share a provider's live position during an active assignment."
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sami.errands",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "SaMi uses your location to set pickup points and share provider location during active errands."
      }
    },
    "android": {
      "package": "com.sami.errands",
      "backgroundColor": "#000535",
      "adaptiveIcon": {
        "foregroundImage": "./assets/sami-app-icon-1024.png",
        "backgroundColor": "#000535"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "c09e119e-8a6b-4a1e-a7c6-b85cfd4e330d"
      }
    },
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    }
  }
}
