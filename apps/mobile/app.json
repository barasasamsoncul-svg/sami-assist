{
  "expo": {
    "name": "SaMi",
    "slug": "sami-mobile",
    "scheme": "sami",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#061426",
          "image": "./assets/icon.png",
          "imageWidth": 160,
          "dark": {
            "backgroundColor": "#061426",
            "image": "./assets/icon.png"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SaMi uses your location to set errand pickup points and share a provider's live position during an active assignment."
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      "react-native-maps",
      [
        "@config-plugins/react-native-webrtc",
        {
          "microphonePermission": "SaMi uses the microphone for voice calls with the customer or assigned errand provider."
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sami.errands",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "SaMi uses your location to set pickup points and share provider location during active errands.",
        "NSMicrophoneUsageDescription": "SaMi uses your microphone only while you are on an in-app voice call with the assigned participant for an errand."
      },
      "backgroundColor": "#061426"
    },
    "android": {
      "package": "com.sami.errands",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A1A40"
      },
      "backgroundColor": "#061426"
    },
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "icon": "./assets/icon.png",
    "extra": {
      "eas": {
        "projectId": "c09e119e-8a6b-4a1e-a7c6-b85cfd4e330d"
      }
    },
    "backgroundColor": "#061426",
    "web": {
      "backgroundColor": "#061426"
    },
    "androidNavigationBar": {
      "backgroundColor": "#061426",
      "barStyle": "light-content",
      "enforceContrast": false
    },
    "androidStatusBar": {
      "backgroundColor": "#061426",
      "barStyle": "light-content",
      "translucent": false
    }
  }
}
