
{
  "expo": {
    "name": "SaMi",
    "slug": "sami-mobile",
    "scheme": "sami",
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": ["android", "ios"],
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000535",
          "image": "./assets/sami-splash-logo-1024.png",
          "imageWidth": 288,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#000535",
            "image": "./assets/sami-splash-logo-1024.png"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SaMi uses your location to set errand pickup points and share a provider's live position during an active assignment."
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      "react-native-maps",
      [
        "@config-plugins/react-native-webrtc",
        {
          "microphonePermission": "SaMi uses the microphone for voice calls with the customer or assigned errand provider."
        }
      ],
      [
        "expo-status-bar",
        {
          "hidden": false,
          "style": "light"
        }
      ],
      [
  "expo-image-picker",
  {
    "photosPermission": "SaMi needs access to your photos so you can choose a profile picture."
  }
]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sami.errands",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "SaMi uses your location to set pickup points and share provider location during active errands.",
        "NSMicrophoneUsageDescription": "SaMi uses your microphone only while you are on an in-app voice call with the assigned participant for an errand."
      },
      "backgroundColor": "#000535"
    },
    "android": {
      "package": "com.sami.errands",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/sami-app-icon-1024.png",
        "backgroundColor": "#000535"
      },
      "backgroundColor": "#000535"
    },
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "icon": "./assets/sami-app-icon-1024.png",
    "extra": {
      "eas": {
        "projectId": "c09e119e-8a6b-4a1e-a7c6-b85cfd4e330d"
      }
    },
    "backgroundColor": "#000535",
    "web": {
      "backgroundColor": "#000535"
    }
  }
}
