# ============================================================
# SaMi commercial pricing
# ============================================================

SAMI_BILLING_STANDARD_PRICE_PER_USER_MONTHLY=2500
SAMI_BILLING_CUSTOM_PRICE_PER_USER_MONTHLY=4500

# Overdue grace before SaMi suspends normal workspace work.
# 0–90 days; recommended/default: 14.
SAMI_BILLING_PAST_DUE_GRACE_DAYS=14

# Keep the billing provider explicit.
# Supported: pesapal | stripe | paystack
SAMI_BILLING_PROVIDER=pesapal

# PesaPal API 3.0
PESAPAL_ENV=sandbox
PESAPAL_CONSUMER_KEY=<your-pesapal-consumer-key>
PESAPAL_CONSUMER_SECRET=<your-pesapal-consumer-secret>
PESAPAL_IPN_ID=<your-registered-pesapal-ipn-id>


# ============================================================
# Alternative billing provider — Stripe
# Configure only when SAMI_BILLING_PROVIDER=stripe
# ============================================================

STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Optional server-side compatibility alias; normally leave blank when NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY is set.
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional. SaMi can discover/create products when these are blank.
STRIPE_STANDARD_PRODUCT_ID=
STRIPE_CUSTOM_PRODUCT_ID=


# ============================================================
# Alternative billing provider — Paystack
# Configure only when SAMI_BILLING_PROVIDER=paystack
# ============================================================

PAYSTACK_SECRET_KEY=


# Manual/internal billing-worker authentication.
SAMI_BILLING_WORKER_SECRET=<generate-a-long-random-secret>

# Vercel Cron authentication for daily billing reconciliation.
# Use a different long random secret from SAMI_BILLING_WORKER_SECRET.
CRON_SECRET=<generate-another-long-random-secret>


# ============================================================
# Category 23 — Usage, Limits & Entitlements
# ============================================================
#
# Free and Standard AI query allowances are fixed by the SaMi plan
# policy (100 and 1,000 queries/user/month respectively).
#
# Custom AI is cost-controlled. Leave blank to meter usage without
# imposing a fixed query ceiling, or set a positive integer as an
# operational monthly guardrail.
#
SAMI_USAGE_CUSTOM_AI_MONTHLY_QUERIES_PER_USER=
#
# Cloud storage is always metered. These optional byte values add
# hard workspace storage ceilings per plan. Blank means the resource
# remains platform-controlled/metered; it does NOT create a marketed
# "unlimited" entitlement.
#
SAMI_USAGE_FREE_STORAGE_BYTES=
SAMI_USAGE_STANDARD_STORAGE_BYTES=
SAMI_USAGE_CUSTOM_STORAGE_BYTES=

# SaMi AI attachment safety controls.
# These are platform guardrails, not marketed plan entitlements.
SAMI_AI_MAX_ATTACHMENTS_PER_MESSAGE=5
SAMI_AI_ATTACHMENT_TEXT_MAX_BYTES=524288


# ============================================================
# SaMi email — shared transactional + workspace notifications
# ============================================================

APP_URL=https://your-sami-domain.example

SMTP_HOST=<your-smtp-host>
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<your-smtp-user>
SMTP_PASSWORD=<your-smtp-password>

# Recommended branded sender identity.
EMAIL_FROM=SaMi <notifications@your-sami-domain.example>

# Optional support/reply address.
EMAIL_REPLY_TO=<your-reply-address>


# ============================================================
# SaMi branded SMS — recommended Kenya setup: Africa's Talking
# ============================================================

SAMI_SMS_PROVIDER=africastalking
SAMI_SMS_DEFAULT_COUNTRY_CODE=254

# Sandbox while integrating/testing:
AFRICASTALKING_ENVIRONMENT=sandbox
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=<your-sandbox-api-key>

# Leave this unset in sandbox unless your sandbox account provides a sender.
# AFRICASTALKING_SENDER_ID=SaMi

# Production after the SaMi sender ID and production application are approved:
# AFRICASTALKING_ENVIRONMENT=production
# AFRICASTALKING_USERNAME=<your-production-application-username>
# AFRICASTALKING_API_KEY=<your-production-api-key>
# AFRICASTALKING_SENDER_ID=SaMi

# Normally leave endpoint unset; SaMi chooses sandbox/production automatically.
# AFRICASTALKING_SMS_ENDPOINT=


# ============================================================
# Alternative SMS provider — Twilio
# Use these only if SAMI_SMS_PROVIDER=twilio
# ============================================================

# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_MESSAGING_SERVICE_SID=
# Or instead:
# TWILIO_FROM_NUMBER=+...


# ============================================================
# IMPORTANT cleanup
# ============================================================

# Remove old provider-specific price variables if present.
# They no longer control SaMi pricing:
#
# PESAPAL_PRICE_STANDARD_MONTHLY
# PESAPAL_PRICE_CUSTOM_MONTHLY
